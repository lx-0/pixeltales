# Frontend Configuration
VITE_DEV=true

# API Settings
VITE_BACKEND_URL=http://localhost:3000

# Supabase Configuration
VITE_SUPABASE_URL=your-supabase-url
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Debug Settings - set to 'true' to enable
VITE_DEBUG=false                      # Enables detailed logging
VITE_DEBUG_APP=false                  # Enables detailed app logging
VITE_DEBUG_API=false                  # Enables detailed api logging
VITE_DEBUG_AUTH=false                 # Enables detailed auth hook logging
VITE_DEBUG_WEBSOCKET=false            # Enables detailed websocket logging
VITE_DEBUG_SCENE=false                # Enables detailed (game) scene logging
VITE_DEBUG_SCENE_STATE=false          # Enables detailed scene state logging
VITE_DEBUG_UI_CONTROLS=false          # Enables detailed ui controls logging
VITE_DEBUG_CHARACTER_MANAGER=false    # Enables detailed character manager logging
VITE_DEBUG_SPEECH_BUBBLES=false       # Enables detailed speech bubble logging
VITE_DEBUG_CHAT_MESSAGES_UI=false     # Enables detailed chat messages ui logging