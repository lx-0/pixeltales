{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    // "rootDir": "./src",
    "incremental": true,
    "paths": {
      "@pixeltales/database/schema": ["../../packages/database/dist/schema.d.ts"],
      "@pixeltales/database": ["../../packages/database/dist/index.d.ts"],
      "@pixeltales/utils": ["../../packages/utils/dist/index.d.ts"]
    },
    "lib": ["es2022"],
    "skipLibCheck": true
  },
  "include": ["src/**/*", "drizzle.config.ts", "test/**/*"],
  "exclude": ["node_modules", "dist"]
}
