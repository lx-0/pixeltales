# Environment
NODE_ENV=development  # development or production
ENV=development  # development or production
PORT=3000

# API Settings (optional - defaults shown)
#PROJECT_NAME=PixelTales
#VERSION=0.1.0
#API_V1_STR=/api/v1

# CORS Settings (optional - default shown)
#BACKEND_CORS_ORIGINS=["http://localhost:5173"]
#CORS_ORIGINS=http://localhost:5173

# Database Settings
# For development (default):
DB_TYPE=sqlite
# The SQLite database will be created in the project root directory
# Only set SQLITE_URL if you want to store the database elsewhere:
#SQLITE_URL=sqlite+aiosqlite:///path/to/your/custom/location/pixeltales.db
DATABASE_URL="../../../data/sqlite/pixeltales.db"

# For production with Supabase (required if DB_TYPE=postgresql):
#DB_TYPE=postgresql
# Get these from your Supabase project settings -> Database
#POSTGRES_USER=postgres                                  # Database username
#POSTGRES_PASSWORD=your-db-password                      # Database password
#POSTGRES_HOST=your-project-ref.supabase.co              # Host URL without protocol
#POSTGRES_PORT=5432                                      # Usually 5432 for Supabase
#POSTGRES_DB=postgres                                    # Default for Supabase
#POSTGRES_SCHEMA=pixeltales_prod                         # Default schema

# Supabase configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# LLM Settings
OPENAI_API_KEY=your-api-key-here  # Required: Get this from OpenAI
ANTHROPIC_API_KEY=your-api-key-here  # Required: Get this from Anthropic
DEFAULT_MODEL=gpt-4o-mini       # Optional: Defaults to gpt-4o-mini

# Docker
DOCKER_ENV=false

# Debug settings
DB_DEBUG_LOGGING=false  # Set to true to log database queries with the application logger
DEBUG_API_AUTH=false
DEBUG_API_SUPABASE_AUTH=false
FRONTEND_URL=http://localhost:5173
