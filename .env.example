# Environment Configuration Example
# Copy this file to either:
#   .env.development (for ENV=development)
#   .env.production (for ENV=production)

# Required (one of):
#   (a) OPENAI_API_KEY (and optionally ANTHROPIC_API_KEY) for direct provider calls, OR
#   (b) LITELLM_BASE_URL + LITELLM_API_KEY to route everything through a LiteLLM gateway
OPENAI_API_KEY=your-api-key-here
#ANTHROPIC_API_KEY=your-api-key-here

# LiteLLM gateway (OpenAI-compatible). Overrides OPENAI/ANTHROPIC keys.
#LITELLM_BASE_URL=https://llm.example.com/v1
#LITELLM_API_KEY=your-gateway-key

# Port Configuration
FRONTEND_PORT=5173  # Dev: 5173, Prod: 80 (defaults)
BACKEND_PORT=8000   # (default)

# CORS Configuration
# For development (default):
#BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://localhost", "http://127.0.0.1:5173", "http://127.0.0.1"]
# For production, add your domain:
#BACKEND_CORS_ORIGINS=["http://localhost:80", "http://localhost", "http://127.0.0.1:80", "http://127.0.0.1", "https://your-domain.com", "http://your-domain.com"]

# Database Configuration
DB_TYPE=sqlite      # sqlite (default) or postgresql
SQLITE_URL=sqlite+aiosqlite:////data/sqlite/pixeltales.db  # (default)

# For PostgreSQL (if needed)
#DB_TYPE=postgresql
#POSTGRES_USER=postgres
#POSTGRES_PASSWORD=your-password
#POSTGRES_HOST=your-project.supabase.co
#POSTGRES_PORT=5432
#POSTGRES_DB=postgres
#POSTGRES_SCHEMA=pixeltales

# Character library — runtime data dir for user-proposed characters.
# Container mounts /data/characters; local dev defaults to data/characters
# relative to backend/. The seed library at app/agent/characters/ is always
# scanned in addition to this dir.
#CHARACTERS_DATA_DIR=/data/characters

# Scene state snapshot retention (per scene_id, default 10).
# Each new snapshot prunes anything beyond the latest N. 0 disables.
#SCENE_SNAPSHOT_RETENTION=10