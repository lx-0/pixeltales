{
  "components": {
    "schemas": {
      "CharacterConfig": {
        "description": "Wire shape returned by the scenes API: a CharacterIdentity merged\nwith a CharacterPlacement at serialize time. Frontend renders this.\n\nNOT used as the storage shape \u2014 SceneConfig stores CharacterPlacement\nand the identity is hydrated from the library before the API responds.",
        "properties": {
          "color": {
            "description": "Character's color in hex format (e.g., #FF0000)",
            "examples": [
              "#FF0000",
              "#00FF00"
            ],
            "pattern": "^#[0-9a-fA-F]{6}$",
            "title": "Color",
            "type": "string"
          },
          "id": {
            "description": "Unique identifier for the character",
            "examples": [
              "bob",
              "alice"
            ],
            "maxLength": 50,
            "minLength": 1,
            "title": "Id",
            "type": "string"
          },
          "initial_action": {
            "enum": [
              "thinking",
              "thinking:love",
              "thinking:anger",
              "thinking:sadness",
              "thinking:surprise",
              "thinking:fear",
              "speaking",
              "idle"
            ],
            "title": "Initial Action",
            "type": "string"
          },
          "initial_direction": {
            "enum": [
              "front",
              "right",
              "left",
              "back"
            ],
            "title": "Initial Direction",
            "type": "string"
          },
          "initial_mood": {
            "title": "Initial Mood",
            "type": "string"
          },
          "initial_position": {
            "$ref": "#/components/schemas/Position"
          },
          "llm_config": {
            "$ref": "#/components/schemas/LLMConfig",
            "description": "Configuration for the character's language model"
          },
          "name": {
            "description": "Character's display name (2-50 characters)",
            "examples": [
              "Bob",
              "Alice"
            ],
            "maxLength": 50,
            "minLength": 2,
            "title": "Name",
            "type": "string"
          },
          "role": {
            "description": "Character's role and personality description (10-5000 characters)",
            "examples": [
              "A friendly shopkeeper who loves to tell stories..."
            ],
            "maxLength": 5000,
            "minLength": 10,
            "title": "Role",
            "type": "string"
          },
          "sprite_id": {
            "default": "bob",
            "description": "ID of a sprite from the backend asset catalog (GET /api/v1/config).",
            "examples": [
              "bob",
              "cleaner_girl",
              "doctor_1",
              "zombie"
            ],
            "title": "Sprite Id",
            "type": "string"
          },
          "visual": {
            "description": "Character's visual appearance description (10-500 characters)",
            "examples": [
              "A tall person with short brown hair and glasses..."
            ],
            "maxLength": 500,
            "minLength": 10,
            "title": "Visual",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "color",
          "role",
          "visual",
          "llm_config",
          "initial_position",
          "initial_direction",
          "initial_action",
          "initial_mood"
        ],
        "title": "CharacterConfig",
        "type": "object"
      },
      "CharacterIdentity": {
        "description": "Library-level character identity \u2014 the part that travels with a\ncharacter across scenes. Lives on disk under app/characters/<id>/ or\ndata/characters/<id>/ (AGENTS.md + .character.yaml).",
        "properties": {
          "color": {
            "description": "Character's color in hex format (e.g., #FF0000)",
            "examples": [
              "#FF0000",
              "#00FF00"
            ],
            "pattern": "^#[0-9a-fA-F]{6}$",
            "title": "Color",
            "type": "string"
          },
          "id": {
            "description": "Unique identifier for the character",
            "examples": [
              "bob",
              "alice"
            ],
            "maxLength": 50,
            "minLength": 1,
            "title": "Id",
            "type": "string"
          },
          "llm_config": {
            "$ref": "#/components/schemas/LLMConfig",
            "description": "Configuration for the character's language model"
          },
          "name": {
            "description": "Character's display name (2-50 characters)",
            "examples": [
              "Bob",
              "Alice"
            ],
            "maxLength": 50,
            "minLength": 2,
            "title": "Name",
            "type": "string"
          },
          "role": {
            "description": "Character's role and personality description (10-5000 characters)",
            "examples": [
              "A friendly shopkeeper who loves to tell stories..."
            ],
            "maxLength": 5000,
            "minLength": 10,
            "title": "Role",
            "type": "string"
          },
          "sprite_id": {
            "default": "bob",
            "description": "ID of a sprite from the backend asset catalog (GET /api/v1/config).",
            "examples": [
              "bob",
              "cleaner_girl",
              "doctor_1",
              "zombie"
            ],
            "title": "Sprite Id",
            "type": "string"
          },
          "visual": {
            "description": "Character's visual appearance description (10-500 characters)",
            "examples": [
              "A tall person with short brown hair and glasses..."
            ],
            "maxLength": 500,
            "minLength": 10,
            "title": "Visual",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "color",
          "role",
          "visual",
          "llm_config"
        ],
        "title": "CharacterIdentity",
        "type": "object"
      },
      "CharacterPlacement": {
        "description": "Scene-level placement: which library character stands where, facing\nwhich way, doing what. Stored in SceneConfig.characters_config; the\nidentity lives in the library and is joined on read.",
        "properties": {
          "id": {
            "description": "Library character id; must exist in the character library.",
            "examples": [
              "bob",
              "alice"
            ],
            "maxLength": 50,
            "minLength": 1,
            "title": "Id",
            "type": "string"
          },
          "initial_action": {
            "enum": [
              "thinking",
              "thinking:love",
              "thinking:anger",
              "thinking:sadness",
              "thinking:surprise",
              "thinking:fear",
              "speaking",
              "idle"
            ],
            "title": "Initial Action",
            "type": "string"
          },
          "initial_direction": {
            "enum": [
              "front",
              "right",
              "left",
              "back"
            ],
            "title": "Initial Direction",
            "type": "string"
          },
          "initial_mood": {
            "title": "Initial Mood",
            "type": "string"
          },
          "initial_position": {
            "$ref": "#/components/schemas/Position"
          }
        },
        "required": [
          "id",
          "initial_position",
          "initial_direction",
          "initial_action",
          "initial_mood"
        ],
        "title": "CharacterPlacement",
        "type": "object"
      },
      "CharacterState": {
        "description": "Runtime state for a character \u2014 the static identity (name, color, role,\nvisual, llm_config, sprite_id) lives in the matching CharacterConfig\ninside SceneConfig. Frontend joins by character id.",
        "properties": {
          "action": {
            "enum": [
              "thinking",
              "thinking:love",
              "thinking:anger",
              "thinking:sadness",
              "thinking:surprise",
              "thinking:fear",
              "speaking",
              "idle"
            ],
            "title": "Action",
            "type": "string"
          },
          "action_estimated_duration": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Action Estimated Duration"
          },
          "action_started_at": {
            "title": "Action Started At",
            "type": "number"
          },
          "current_mood": {
            "default": "neutral",
            "title": "Current Mood",
            "type": "string"
          },
          "direction": {
            "enum": [
              "front",
              "right",
              "left",
              "back"
            ],
            "title": "Direction",
            "type": "string"
          },
          "end_conversation_requested": {
            "default": false,
            "title": "End Conversation Requested",
            "type": "boolean"
          },
          "end_conversation_requested_at": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "End Conversation Requested At"
          },
          "end_conversation_requested_validity_duration": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "End Conversation Requested Validity Duration"
          },
          "id": {
            "description": "Character id; matches a key in SceneConfig.characters_config",
            "examples": [
              "bob",
              "alice"
            ],
            "maxLength": 50,
            "minLength": 1,
            "title": "Id",
            "type": "string"
          },
          "position": {
            "$ref": "#/components/schemas/Position"
          }
        },
        "required": [
          "id",
          "position",
          "direction",
          "action",
          "action_started_at"
        ],
        "title": "CharacterState",
        "type": "object"
      },
      "ColorOption": {
        "description": "Color option configuration.",
        "properties": {
          "group": {
            "title": "Group",
            "type": "string"
          },
          "hex": {
            "title": "Hex",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "hex",
          "group"
        ],
        "title": "ColorOption",
        "type": "object"
      },
      "Comment": {
        "description": "Comment on a scene proposal.",
        "properties": {
          "comment": {
            "title": "Comment",
            "type": "string"
          },
          "timestamp": {
            "title": "Timestamp",
            "type": "string"
          },
          "user": {
            "title": "User",
            "type": "string"
          }
        },
        "required": [
          "user",
          "comment",
          "timestamp"
        ],
        "title": "Comment",
        "type": "object"
      },
      "ConfigOptions": {
        "description": "Available configuration options.",
        "properties": {
          "colors": {
            "items": {
              "$ref": "#/components/schemas/ColorOption"
            },
            "title": "Colors",
            "type": "array"
          },
          "llm_providers": {
            "items": {
              "$ref": "#/components/schemas/LLMProvider"
            },
            "title": "Llm Providers",
            "type": "array"
          },
          "rooms": {
            "items": {
              "$ref": "#/components/schemas/RoomOption"
            },
            "title": "Rooms",
            "type": "array"
          },
          "sprites": {
            "items": {
              "$ref": "#/components/schemas/SpriteOption"
            },
            "title": "Sprites",
            "type": "array"
          }
        },
        "required": [
          "llm_providers",
          "colors",
          "sprites",
          "rooms"
        ],
        "title": "ConfigOptions",
        "type": "object"
      },
      "CreateSceneConfig": {
        "description": "Scene config WRITE shape: clients send placement-only entries.\nCharacter identity (name, color, role, visual, llm_config, sprite_id)\nmust already exist in the library \u2014 POST /api/v1/characters to add a\nnew one before proposing a scene that uses it.",
        "properties": {
          "characters_config": {
            "additionalProperties": {
              "$ref": "#/components/schemas/CharacterPlacement"
            },
            "description": "Per-character placement (id, initial_position/direction/action/mood). Identity is looked up from the library by id at render time.",
            "title": "Characters Config",
            "type": "object"
          },
          "comments": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/Comment"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "description": "List of comments on the scene proposal",
            "title": "Comments"
          },
          "description": {
            "description": "Scene description (10-5000 characters)",
            "examples": [
              "Two friends meet at a coffee shop and discuss their dreams..."
            ],
            "maxLength": 5000,
            "minLength": 10,
            "title": "Description",
            "type": "string"
          },
          "name": {
            "description": "Scene name (3-50 characters)",
            "examples": [
              "Coffee Shop Chat",
              "Park Meeting"
            ],
            "maxLength": 50,
            "minLength": 3,
            "title": "Name",
            "type": "string"
          },
          "proposed_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "ISO format datetime when the scene was proposed",
            "title": "Proposed At"
          },
          "proposer_name": {
            "anyOf": [
              {
                "maxLength": 50,
                "minLength": 2,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Name of the person proposing the scene (2-50 characters)",
            "examples": [
              "John Doe",
              "Jane Smith"
            ],
            "title": "Proposer Name"
          },
          "room_id": {
            "default": "room",
            "description": "ID of a room background from the backend asset catalog (GET /api/v1/config).",
            "examples": [
              "room",
              "the-lab",
              "the-lab-w-docs"
            ],
            "title": "Room Id",
            "type": "string"
          },
          "start_character_id": {
            "description": "ID of the character who starts the conversation",
            "examples": [
              "bob",
              "alice"
            ],
            "title": "Start Character Id",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/SceneConfigStatus",
            "default": "proposed",
            "description": "Current status of the scene configuration (proposed, active, or rejected)"
          },
          "votes": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": 0,
            "description": "Number of votes the scene proposal has received",
            "title": "Votes"
          }
        },
        "required": [
          "name",
          "description",
          "start_character_id",
          "characters_config"
        ],
        "title": "CreateSceneConfig",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "LLMConfig": {
        "description": "LLM configuration for the character.",
        "properties": {
          "max_tokens": {
            "description": "Maximum number of tokens to generate (1-32000)",
            "exclusiveMinimum": 0.0,
            "maximum": 32000.0,
            "title": "Max Tokens",
            "type": "integer"
          },
          "model_name": {
            "description": "The name of the model to use",
            "examples": [
              "gpt-4o-mini",
              "claude-3-5-sonnet-20241022"
            ],
            "maxLength": 50,
            "minLength": 1,
            "title": "Model Name",
            "type": "string"
          },
          "provider": {
            "description": "The LLM provider (openai or anthropic)",
            "enum": [
              "openai",
              "anthropic"
            ],
            "title": "Provider",
            "type": "string"
          },
          "temperature": {
            "description": "Temperature controls randomness (0.0-2.0, default 0.7)",
            "maximum": 2.0,
            "minimum": 0.0,
            "title": "Temperature",
            "type": "number"
          }
        },
        "required": [
          "provider",
          "model_name",
          "max_tokens",
          "temperature"
        ],
        "title": "LLMConfig",
        "type": "object"
      },
      "LLMModel": {
        "description": "LLM model configuration.",
        "properties": {
          "default_temperature": {
            "default": 0.7,
            "title": "Default Temperature",
            "type": "number"
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "max_tokens": {
            "title": "Max Tokens",
            "type": "integer"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "max_tokens"
        ],
        "title": "LLMModel",
        "type": "object"
      },
      "LLMProvider": {
        "description": "LLM provider configuration.",
        "properties": {
          "id": {
            "enum": [
              "openai",
              "anthropic"
            ],
            "title": "Id",
            "type": "string"
          },
          "models": {
            "items": {
              "$ref": "#/components/schemas/LLMModel"
            },
            "title": "Models",
            "type": "array"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "models"
        ],
        "title": "LLMProvider",
        "type": "object"
      },
      "Message": {
        "description": "A message in the conversation.",
        "properties": {
          "calculated_speaking_time": {
            "title": "Calculated Speaking Time",
            "type": "number"
          },
          "character": {
            "title": "Character",
            "type": "string"
          },
          "content": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Content"
          },
          "conversation_rating": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Conversation Rating"
          },
          "end_conversation": {
            "title": "End Conversation",
            "type": "boolean"
          },
          "mood": {
            "title": "Mood",
