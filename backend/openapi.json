                "type": "null"
              }
            ],
            "title": "Reaction On Previous Message"
          },
          "recipient": {
            "title": "Recipient",
            "type": "string"
          },
          "thoughts": {
            "title": "Thoughts",
            "type": "string"
          },
          "timestamp": {
            "title": "Timestamp",
            "type": "string"
          },
          "unix_timestamp": {
            "title": "Unix Timestamp",
            "type": "number"
          }
        },
        "required": [
          "character",
          "recipient",
          "thoughts",
          "mood",
          "mood_emoji",
          "timestamp",
          "unix_timestamp",
          "calculated_speaking_time",
          "end_conversation"
        ],
        "title": "Message",
        "type": "object"
      },
      "Position": {
        "description": "A position in the scene.",
        "properties": {
          "x": {
            "title": "X",
            "type": "number"
          },
          "y": {
            "title": "Y",
            "type": "number"
          }
        },
        "required": [
          "x",
          "y"
        ],
        "title": "Position",
        "type": "object"
      },
      "RoomOption": {
        "description": "Room background asset option.",
        "properties": {
          "id": {
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "path": {
            "title": "Path",
