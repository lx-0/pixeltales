        "title": "RoomOption",
        "type": "object"
      },
      "SceneConfig": {
        "description": "Scene config READ shape: characters are returned fully hydrated\n(placement merged with library identity) so the frontend can render\nwithout a separate library round-trip per character.",
        "properties": {
          "characters_config": {
            "additionalProperties": {
              "$ref": "#/components/schemas/CharacterConfig"
            },
            "description": "Each entry merges the per-scene placement with the library identity (name, color, role, visual, llm_config, sprite_id).",
            "title": "Characters Config",
            "type": "object"
          },
          "comments": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/Comment"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "description": "List of comments on the scene proposal",
            "title": "Comments"
          },
          "description": {
            "description": "Scene description (10-5000 characters)",
            "examples": [
              "Two friends meet at a coffee shop and discuss their dreams..."
            ],
            "maxLength": 5000,
            "minLength": 10,
            "title": "Description",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "name": {
            "description": "Scene name (3-50 characters)",
            "examples": [
              "Coffee Shop Chat",
              "Park Meeting"
            ],
            "maxLength": 50,
            "minLength": 3,
            "title": "Name",
            "type": "string"
          },
          "proposed_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "ISO format datetime when the scene was proposed",
            "title": "Proposed At"
          },
          "proposer_name": {
            "anyOf": [
              {
                "maxLength": 50,
                "minLength": 2,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Name of the person proposing the scene (2-50 characters)",
            "examples": [
              "John Doe",
              "Jane Smith"
            ],
            "title": "Proposer Name"
          },
          "room_id": {
            "default": "room",
            "description": "ID of a room background from the backend asset catalog (GET /api/v1/config).",
            "examples": [
              "room",
              "the-lab",
              "the-lab-w-docs"
            ],
            "title": "Room Id",
            "type": "string"
          },
          "start_character_id": {
            "description": "ID of the character who starts the conversation",
            "examples": [
              "bob",
              "alice"
            ],
            "title": "Start Character Id",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/SceneConfigStatus",
            "default": "proposed",
            "description": "Current status of the scene configuration (proposed, active, or rejected)"
          },
          "system_prompt": {
            "description": "System prompt that sets the context and rules (10-1000 characters)",
            "examples": [
              "You are in a cozy coffee shop on a rainy afternoon..."
            ],
            "maxLength": 1000,
            "minLength": 10,
            "title": "System Prompt",
            "type": "string"
          },
          "votes": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": 0,
            "description": "Number of votes the scene proposal has received",
            "title": "Votes"
          }
        },
        "required": [
          "name",
          "description",
          "start_character_id",
          "id",
          "characters_config",
          "system_prompt"
        ],
        "title": "SceneConfig",
        "type": "object"
      },
      "SceneConfigStatus": {
        "description": "Scene config status enum.",
        "enum": [
          "proposed",
          "active",
          "rejected"
        ],
        "title": "SceneConfigStatus",
        "type": "string"
      },
      "SceneState": {
