{
  "components": {
    "schemas": {
      "CharacterConfig": {
        "description": "Configuration for a character.",
        "properties": {
          "color": {
            "description": "Character's color in hex format (e.g., #FF0000)",
            "examples": [
              "#FF0000",
              "#00FF00"
            ],
            "pattern": "^#[0-9a-fA-F]{6}$",
            "title": "Color",
            "type": "string"
          },
          "id": {
            "description": "Unique identifier for the character",
            "examples": [
              "bob",
              "alice"
            ],
            "maxLength": 50,
            "minLength": 1,
            "title": "Id",
            "type": "string"
          },
          "initial_action": {
            "enum": [
              "thinking",
              "thinking:love",
              "thinking:anger",
              "thinking:sadness",
              "thinking:surprise",
              "thinking:fear",
              "speaking",
              "idle"
            ],
            "title": "Initial Action",
            "type": "string"
          },
          "initial_direction": {
            "enum": [
              "front",
              "right",
              "left",
              "back"
            ],
            "title": "Initial Direction",
            "type": "string"
          },
          "initial_mood": {
            "title": "Initial Mood",
            "type": "string"
          },
          "initial_position": {
            "$ref": "#/components/schemas/Position"
          },
          "llm_config": {
            "$ref": "#/components/schemas/LLMConfig",
            "description": "Configuration for the character's language model"
          },
          "name": {
            "description": "Character's display name (2-50 characters)",
            "examples": [
              "Bob",
              "Alice"
            ],
            "maxLength": 50,
            "minLength": 2,
            "title": "Name",
            "type": "string"
          },
          "role": {
            "description": "Character's role and personality description (10-5000 characters)",
            "examples": [
              "A friendly shopkeeper who loves to tell stories..."
            ],
            "maxLength": 5000,
            "minLength": 10,
            "title": "Role",
            "type": "string"
          },
          "visual": {
            "description": "Character's visual appearance description (10-500 characters)",
            "examples": [
              "A tall person with short brown hair and glasses..."
            ],
            "maxLength": 500,
            "minLength": 10,
            "title": "Visual",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "color",
          "role",
          "visual",
          "llm_config",
          "initial_position",
          "initial_direction",
          "initial_action",
          "initial_mood"
        ],
        "title": "CharacterConfig",
        "type": "object"
      },
      "CharacterState": {
