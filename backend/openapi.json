  "info": {
    "title": "PixelTales",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/config": {
      "get": {
        "description": "Get available configuration options.",
        "operationId": "get_config_options_api_v1_config_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConfigOptions"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Get Config Options",
        "tags": [
          "config"
        ]
      }
    },
    "/api/v1/scenes/propose": {
      "post": {
        "operationId": "propose_scene_api_v1_scenes_propose_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateSceneConfig"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SceneConfig"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Propose Scene",
        "tags": [
          "scenes"
        ]
      }
    },
    "/api/v1/scenes/proposed": {
      "get": {
        "operationId": "get_proposed_scenes_api_v1_scenes_proposed_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/SceneConfig"
                  },
                  "title": "Response Get Proposed Scenes Api V1 Scenes Proposed Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
