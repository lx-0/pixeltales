      "CreateSceneConfig": {
        "description": "Scene configuration for creation without ID.",
        "properties": {
          "characters_config": {
            "additionalProperties": {
              "$ref": "#/components/schemas/CharacterConfig"
            },
            "description": "Configuration for each character in the scene, keyed by character ID",
            "title": "Characters Config",
            "type": "object"
          },
          "comments": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/Comment"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "description": "List of comments on the scene proposal",
            "title": "Comments"
          },
          "description": {
            "description": "Scene description (10-5000 characters)",
            "examples": [
              "Two friends meet at a coffee shop and discuss their dreams..."
            ],
            "maxLength": 5000,
            "minLength": 10,
            "title": "Description",
            "type": "string"
          },
          "name": {
            "description": "Scene name (3-50 characters)",
            "examples": [
              "Coffee Shop Chat",
              "Park Meeting"
            ],
            "maxLength": 50,
            "minLength": 3,
            "title": "Name",
            "type": "string"
          },
          "proposed_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "ISO format datetime when the scene was proposed",
            "title": "Proposed At"
          },
          "proposer_name": {
            "anyOf": [
              {
                "maxLength": 50,
                "minLength": 2,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Name of the person proposing the scene (2-50 characters)",
            "examples": [
              "John Doe",
              "Jane Smith"
            ],
            "title": "Proposer Name"
          },
          "start_character_id": {
            "description": "ID of the character who starts the conversation",
            "examples": [
              "bob",
              "alice"
            ],
            "title": "Start Character Id",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/SceneConfigStatus",
            "default": "proposed",
            "description": "Current status of the scene configuration (proposed, active, or rejected)"
          },
          "votes": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": 0,
            "description": "Number of votes the scene proposal has received",
            "title": "Votes"
          }
        },
        "required": [
          "name",
          "description",
          "start_character_id",
          "characters_config"
        ],
        "title": "CreateSceneConfig",
        "type": "object"
      },
