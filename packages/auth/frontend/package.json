    "lint": "eslint .",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "@supabase/auth-helpers-react": "^0.5.0",
    "@supabase/auth-ui-react": "^0.4.7",
    "@supabase/auth-ui-shared": "^0.1.8",
    "@supabase/supabase-js": "^2.49.4",
    "@yesterday-ai/api-contracts": "workspace:^",
    "@yesterday-ai/api-frontend": "workspace:^",
    "@yesterday-ai/auth-contracts": "workspace:^",
    "@yesterday-ai/logger-frontend": "workspace:^",
    "@yesterday-ai/shadcn-ui": "workspace:^",
    "@yesterday-ai/spritesheet-contracts": "workspace:^",
    "@yesterday-ai/spritesheet-frontend": "workspace:^",
    "@yesterday-ai/user-contracts": "workspace:^",
    "lucide-react": "^0.469.0",
    "react": "^19.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/react": "^19.0.10",
    "eslint": "^9.24.0",
    "rimraf": "^6.0.1",
    "tsup": "^8.2.3",
    "typescript": "^5.5.4",
    "vite": "^6.2.0"
