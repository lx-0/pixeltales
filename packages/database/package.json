{
  "name": "@pixeltales/database",
  "version": "0.0.1",
  "private": true,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "lint": "eslint .",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "@yesterday-ai/auth-contracts": "workspace:^",
    "@yesterday-ai/llm-contracts": "workspace:^",
    "nanoid": "^3.0.1",
    "drizzle-zod": "^0.7.1",
    "drizzle-orm": "^0.42.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "eslint": "^9.24.0",
    "rimraf": "^6.0.1",
    "tsup": "^8.2.3",
    "typescript": "^5.5.4"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  }
}
