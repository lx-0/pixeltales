{
  "name": "turborepo",
  "version": "1.0.0",
  "description": "",
  "private": true,
  "packageManager": "pnpm@9.13.0",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "turbo run frontend#dev backend#dev --parallel",
    "dev:frontend": "turbo run frontend#dev",
    "dev:backend": "turbo run backend#dev",
    "build": "turbo run build",
    "build:packages": "turbo run build --filter=@yesterday-ai/* && turbo run build --filter=@pixeltales/*",
    "clean": "turbo run clean && rm -rf node_modules",
    "clean:deep": "turbo run clean && find . -name 'node_modules' -type d -prune -exec rimraf '{}' + && pnpm install",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.29.1",
    "@typescript-eslint/parser": "^8.29.1",
    "eslint": "^9.24.0",
    "eslint-config-prettier": "^10.1.2",
    "prettier": "^3.5.3",
    "rimraf": "^6.0.1",
    "turbo": "^2.5.0"
  },
  "resolutions": {
    "punycode": "2.3.1"
  },
  "overrides": {
    "punycode": "2.3.1"
  }
}
